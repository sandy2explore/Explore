          100 * SUM(CASE WHEN state = 4 THEN 1 ELSE 0 END)
              / NULLIF(COUNT(*), 0),
          2
      ) AS pct_complete
  FROM request_history
  WHERE requestid       = &request_id
     OR parentrequestid = &request_id
  GROUP BY
      NVL(parentrequestid, requestid),
      type
  ORDER BY
      process_type;
   
   


