WITH snap_sga AS (
    SELECT
        TRUNC(s.begin_interval_time) AS snap_day,
        sg.instance_number,
        sg.snap_id,
        SUM(sg.bytes) AS total_sga_bytes,
        SUM(CASE WHEN sg.name = 'free memory' THEN sg.bytes ELSE 0 END) AS free_sga_bytes
    FROM dba_hist_sgastat sg
    JOIN dba_hist_snapshot s
        ON s.snap_id = sg.snap_id
       AND s.dbid = sg.dbid
       AND s.instance_number = sg.instance_number
    WHERE s.begin_interval_time >= TRUNC(SYSDATE) - 9
      AND s.begin_interval_time <  TRUNC(SYSDATE) + 1
    GROUP BY
        TRUNC(s.begin_interval_time),
        sg.instance_number,
        sg.snap_id
)
SELECT
    snap_day,
    instance_number,
    ROUND(AVG(total_sga_bytes) / 1024 / 1024 / 1024, 2) AS avg_total_sga_gb,
    ROUND(AVG(total_sga_bytes - free_sga_bytes) / 1024 / 1024 / 1024, 2) AS avg_used_sga_gb,
    ROUND(AVG(free_sga_bytes) / 1024 / 1024 / 1024, 2) AS avg_free_sga_gb,
    ROUND(
        AVG((total_sga_bytes - free_sga_bytes) / NULLIF(total_sga_bytes, 0)) * 100,
        2
    ) AS avg_sga_used_pct
FROM snap_sga
GROUP BY
    snap_day,
    instance_number
ORDER BY
    snap_day,
    instance_number;


