 with
  params as (
    select
      'EHPV'   as p_pod
     ,4  as p_con_id
     ,66795 as p_bgnsnap
     ,66796 as p_endsnap
     ,619409420    as p_dbid
    from dual
    where 1=1
    /*
       l_query := replace(l_query, 'EHPV', EHPV);
       l_query := replace(l_query,'4',4);
       l_query := replace(l_query,'66795',l_bgnsnap);
       l_query := replace(l_query,'66796',l_endsnap);
       l_query := replace(l_query,'619409420',619409420);
    */
  )
 ,snaps as (
    select/*+ no_merge materialize
     */
        dbid
       ,p.p_pod
       ,instance_number as inst
       ,snap_id as snap
       ,begin_interval_time
       ,end_interval_time
    from params p, dba_hist_snapshot s
    where SNAP_ID between p.p_bgnsnap and p.p_endsnap
       and s.dbid    = p.p_dbid
 )
 ,dbids as (
    select/*+ materialize */
        dbid
       ,instance_number as inst
       ,max(db_name) keep(dense_rank last order by i.startup_time) as db_name
       ,max(instance_name)keep(dense_rank last order by i.startup_time) as instance_name
       ,max(regexp_substr(host_name,'[^.]+',1,1))keep(dense_rank last order by i.startup_time) host_name
    from params p, dba_hist_database_instance i
    where dbid   = p.p_dbid
    group by
        dbid
       ,instance_number
 )
 ,stats as (
     select/*+ no_merge */
            p.DBID            as dbid
           ,p.instance_number as inst
           ,p.SNAP_ID         as snap
           --,p.CON_DBID
           --,p.CON_ID
           ,p.NUM_CPUS
           ,p.LOAD
           ,p.IDLE_TIME   - lag( p.IDLE_TIME    ,1,null)over(partition by p.DBID, p.instance_number, p.con_dbid, p.con_id order by p.snap_id) as IDLE_TIME
           ,p.BUSY_TIME   - lag( p.BUSY_TIME    ,1,null)over(partition by p.DBID, p.instance_number, p.con_dbid, p.con_id order by p.snap_id) as BUSY_TIME
           ,p.USER_TIME   - lag( p.USER_TIME    ,1,null)over(partition by p.DBID, p.instance_number, p.con_dbid, p.con_id order by p.snap_id) as USER_TIME
           ,p.SYS_TIME    - lag( p.SYS_TIME     ,1,null)over(partition by p.DBID, p.instance_number, p.con_dbid, p.con_id order by p.snap_id) as SYS_TIME
           ,p.IOWAIT_TIME - lag( p.IOWAIT_TIME  ,1,null)over(partition by p.DBID, p.instance_number, p.con_dbid, p.con_id order by p.snap_id) as IOWAIT_TIME
           ,p.NICE_TIME   - lag( p.NICE_TIME    ,1,null)over(partition by p.DBID, p.instance_number, p.con_dbid, p.con_id order by p.snap_id) as NICE_TIME
           ,p.PHYSICAL_MEMORY_BYTES
           ,p.SWAP_FREE_BYTES
           ,p.INACTIVE_MEMORY_BYTES
           ,p.FREE_MEMORY_BYTES

           ,p.IDLE_TIME   as osstat_orig_IDLE_TIME
           ,p.BUSY_TIME   as osstat_orig_BUSY_TIME
           ,p.USER_TIME   as osstat_orig_USER_TIME
           ,p.SYS_TIME    as osstat_orig_SYS_TIME
           ,p.IOWAIT_TIME as osstat_orig_IOWAIT_TIME
           ,p.NICE_TIME   as osstat_orig_NICE_TIME
     from (
         select
                *
         from (
             select/*+ no_merge */
                o.SNAP_ID
               ,o.DBID
               ,o.INSTANCE_NUMBER
               ,o.CON_DBID
               ,o.CON_ID
               --,o.STAT_ID
               ,o.STAT_NAME
               ,o.VALUE
             from params p
                 ,DBA_HIST_OSSTAT o
                  --AWR_CDB_OSSTAT
             where 1=1
             and o.stat_name in (
              'NUM_CPUS'
             ,'LOAD'
             ,'IDLE_TIME'
             ,'BUSY_TIME'
             ,'USER_TIME'
             ,'SYS_TIME'
             ,'IOWAIT_TIME'
             ,'NICE_TIME'
             ,'PHYSICAL_MEMORY_BYTES'
             ,'SWAP_FREE_BYTES'
             ,'INACTIVE_MEMORY_BYTES'
             ,'FREE_MEMORY_BYTES'
             )
         --and (DBID,INSTANCE_NUMBER,SNAP_ID) in (select dbid,inst,snap from snaps)
         and SNAP_ID between p.p_bgnsnap -1 and p.p_endsnap and dbid = p.p_dbid
         and rownum>0
         ) v1
         pivot (
               max(value)
               for stat_name in (
                  'NUM_CPUS'              as NUM_CPUS
                 ,'LOAD'                  as LOAD
                 ,'IDLE_TIME'             as IDLE_TIME
                 ,'BUSY_TIME'             as BUSY_TIME
                 ,'USER_TIME'             as USER_TIME
                 ,'SYS_TIME'              as SYS_TIME
                 ,'IOWAIT_TIME'           as IOWAIT_TIME
                 ,'NICE_TIME'             as NICE_TIME
                 ,'PHYSICAL_MEMORY_BYTES' as PHYSICAL_MEMORY_BYTES
                 ,'SWAP_FREE_BYTES'       as SWAP_FREE_BYTES
                 ,'INACTIVE_MEMORY_BYTES' as INACTIVE_MEMORY_BYTES
                 ,'FREE_MEMORY_BYTES'     as FREE_MEMORY_BYTES
                 )
         )
     ) p
 )
 ,metrics_1 as (
     select
          snap_id
         ,dbid
         ,instance_number
         ,stat_name
         ,con_dbid
         ,con_id
         ,case
              when abs(value - value_prev) > 0.9*greatest(value,value_prev)
                then least(value, value_prev)
              else abs(value - value_prev)
           end
           as val
     from (
         select
              snap_id
             ,dbid
             ,instance_number
             ,stat_id
             ,stat_name
             ,con_dbid
             ,con_id
             ,value
             ,lag(value)
              over(
                partition by
                      dbid
                     ,instance_number
                     ,stat_id
                     ,stat_name
                     ,con_dbid
                     ,con_id
                order by
                     snap_id
                )
             as value_prev
         from params p
             ,DBA_HIST_CON_SYS_TIME_MODEL tm
         where tm.stat_name in (
            'DB time'
           ,'DB CPU'
           ,'background cpu time'
           )
         --and (DBID,INSTANCE_NUMBER,SNAP_ID) in (select dbid,inst,snap from snaps)
         and SNAP_ID between p.p_bgnsnap -1 and p.p_endsnap and dbid = p.p_dbid
     )
  )
 ,metrics_2 as (
     select
          snap_id
         ,dbid
         ,instance_number
         ,stat_name
         ,con_dbid
         ,con_id
         ,case
              when stat_name='session pga memory max' then value
              when value_prev>value then value
              when value_prev<value then value - value_prev
              else null
           end
           as val
     from (
         select
              snap_id
             ,dbid
             ,instance_number
             ,stat_name
             ,con_dbid
             ,con_id
             ,value
             ,lag(value)
              over(
                partition by
                      dbid
                     ,instance_number
                     ,stat_id
                     ,stat_name
                     ,con_dbid
                     ,con_id
