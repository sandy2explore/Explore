WITH all_tasks AS (
    SELECT
        act_task.assignment_task_id,
        act_task.assignment_task_number,
        act_task.effective_start_date,
        act_task.effective_end_date,
        act_task.assignment_record_id,
        act_task.parent_task_id,
        act_task.learning_item_id,
        act_task.completion_date
    FROM
        wlf_assignment_tasks_f act_task
    WHERE
            act_task.task_status = 'ORA_ASSN_TASK_COMPLETED'
        AND act_task.task_sub_status = 'ORA_ASSN_TASK_COMPLETED'
        AND act_task.source_object_id IS NULL
        AND act_task.learning_item_type = 'ORA_ACTIVITY'
        AND act_task.last_update_date >= TO_DATE('21/03/2025', 'dd/mm/yyyy')
        AND sysdate BETWEEN act_task.effective_start_date AND act_task.effective_end_date
), active_asgn_tasks AS (
    SELECT
        t.*
    FROM
             all_tasks t
        INNER JOIN wlf_assignment_records_f a 
    ON a.assignment_record_id = t.assignment_record_id
    WHERE
        a.status IN ( 'ORA_ASSN_REC_ACTIVE', 'ORA_ASSN_REC_CONTENT_COMPLETE')
        AND a.sub_status IN ( 'ORA_ASSN_REC_NOTSTARTED', 'ORA_ASSN_REC_INPROGRESS', 
         'ORA_ASSN_REC_CONTENT_COMPLETE' )
        AND sysdate BETWEEN a.effective_start_date AND a.effective_end_date
), section_tasks AS (
    SELECT
        p.*
    FROM
             active_asgn_tasks ats
        INNER JOIN wlf_assignment_tasks_f p ON p.assignment_task_id = ats.parent_task_id
    WHERE
            p.task_status = 'ORA_ASSN_TASK_NOT_COMPLETED'
        AND p.task_sub_status in ('ORA_ASSN_TASK_IN_PROGRESS','ORA_ASSN_TASK_NOT_STARTED')
        AND p.learning_item_type = 'ORA_ACTIVITY_SECTION'
        AND p.req_act_completion_count > 0
        AND sysdate BETWEEN p.effective_start_date AND p.effective_end_date
), activity_tasks AS (
    SELECT
        st.assignment_task_id,
        --t.assignment_task_id,
        --t.assignment_record_id,
        st.req_act_completion_count,
        st.completed_activity_count,
        SUM(
            CASE
                WHEN a.content_type = 'ORA_OBSERVATION_CHECKLIST'
                     AND t.task_owner_type = 'ORA_LEARNER' THEN
                    0
                ELSE
                    1
            END
        )
        OVER(PARTITION BY t.parent_task_id) total_completed_count
    FROM
        wlf_assignment_tasks_f t,
        wlf_li_activities_f    a,
        section_tasks          st
    WHERE
            t.parent_task_id = st.assignment_task_id
        AND t.learning_item_id = a.learning_item_id
        AND t.task_status IN ( 'ORA_ASSN_TASK_COMPLETED', 'ORA_ASSN_TASK_EXEMPTED' )
        AND t.task_sub_status IN ( 'ORA_ASSN_TASK_COMPLETED', 'ORA_ASSN_TASK_EXEMPTED' )
        AND trunc(sysdate) BETWEEN t.effective_start_date AND t.effective_end_date
        AND trunc(sysdate) BETWEEN a.effective_start_date AND a.effective_end_date
)
SELECT /* Activity HDL Detection Query */
    t.assignment_task_number,
