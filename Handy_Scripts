REM
REM fsredb_show_aas_imbal.sql - Bug 39282807 - report imbalance if AAS across DB instances is deviated by imbalance_pct% for atleast imbalance_min_pct% time of window_mins.
REM Contact adatti if any questions.
REM 2026-05-07
REM

set pages 0 lines 300 verify off feedback off

DEF imbalance_pct     = 50
DEF imbalance_min_pct = 50
DEF window_mins       = 30

WITH m AS (
  SELECT h.inst_id,
         TRUNC(h.end_time, 'MI') AS sample_minute,
         h.value AS aas
  FROM   gv$sysmetric_history h
  WHERE  h.metric_name   = 'Average Active Sessions'
    AND  h.con_id        = 0
    AND  h.intsize_csec BETWEEN 5000 AND 7000
    AND  h.end_time     > SYSDATE - NUMTODSINTERVAL(&window_mins, 'MINUTE')
    AND  h.end_time     <= SYSDATE
),
f AS (
  SELECT CASE
           WHEN COUNT(*) > 0
            AND (100 * SUM(is_imbalanced) / COUNT(*)) >= &imbalance_min_pct
           THEN 1
           ELSE 0
         END AS imbalance_found
  FROM (
    SELECT sample_minute,
           CASE
             WHEN MIN(aas) < AVG(aas) * (1 - &imbalance_pct / 100)
               OR MAX(aas) > AVG(aas) * (1 + &imbalance_pct / 100)
             THEN 1
             ELSE 0
           END AS is_imbalanced
      FROM m
     GROUP BY sample_minute
  )
)
SELECT
  (
    SELECT LISTAGG(
             instance_name || ':' || aas_rounded || '(' || pct_rounded || '%)' ||
			 CASE
			                WHEN imbalance_found = 1
			                 AND avg_aas > cluster_avg_aas * (1 + &imbalance_pct / 100)
			                THEN '(imbal)'
			                ELSE ''
			              END,
			              '~'
			            ) WITHIN GROUP (ORDER BY inst_id)
			     FROM (
			       SELECT i.inst_id,
			              i.instance_name,
			              NVL(a.avg_aas, 0) AS avg_aas,
			              AVG(NVL(a.avg_aas, 0)) OVER () AS cluster_avg_aas,
			              ROUND(NVL(a.avg_aas, 0), 0) AS aas_rounded,
			              NVL(ROUND(100 * RATIO_TO_REPORT(NVL(a.avg_aas, 0)) OVER (), 0), 0) AS pct_rounded,
			              f.imbalance_found
			       FROM   gv$instance i
			       LEFT JOIN (
			         SELECT inst_id,
			                AVG(aas) AS avg_aas
			           FROM m
			          GROUP BY inst_id
			       ) a
			         ON a.inst_id = i.inst_id
			       CROSS JOIN f
			     )
			   )
			   ||
			   (
			     SELECT CASE
			              WHEN imbalance_found = 1
			              THEN '~AAS_IMBALANCE_FOUND'
			              ELSE ''
			            END
			       FROM f
			   ) AS monitor_output
			 FROM dual;
			 




