WITH redo_snaps AS (
      SELECT ss.dbid,
             ss.instance_number,
             ss.snap_id,
             sn.begin_interval_time,
             sn.end_interval_time,
             ss.value - LAG(ss.value) OVER (
                 PARTITION BY ss.dbid, ss.instance_number, sn.startup_time, ss.stat_name
                 ORDER BY ss.snap_id
             ) AS redo_bytes
      FROM dba_hist_sysstat ss
      JOIN dba_hist_snapshot sn
        ON sn.dbid = ss.dbid
       AND sn.instance_number = ss.instance_number
       AND sn.snap_id = ss.snap_id
      WHERE ss.stat_name = 'redo size'
        AND sn.end_interval_time >= SYSDATE - 10
  ),
  hot_snaps AS (
      SELECT *
      FROM (
          SELECT r.*,
                 NTILE(10) OVER (ORDER BY redo_bytes DESC) AS redo_decile
          FROM redo_snaps r
          WHERE redo_bytes > 0
      )
      WHERE redo_decile = 1
  ),
  sqls AS (
      SELECT st.dbid,
             st.sql_id,
             st.plan_hash_value,
             MAX(st.parsing_schema_name) AS parsing_schema,
             MAX(st.module) AS module,
             SUM(st.executions_delta) AS executions,
             SUM(st.rows_processed_delta) AS rows_processed,
             SUM(st.buffer_gets_delta) AS buffer_gets,
             SUM(st.disk_reads_delta) AS disk_reads,
             SUM(st.physical_write_bytes_delta) AS physical_write_bytes,
             ROUND(SUM(st.elapsed_time_delta) / 1000000, 2) AS elapsed_sec
      FROM dba_hist_sqlstat st
      JOIN hot_snaps h
        ON h.dbid = st.dbid
       AND h.instance_number = st.instance_number
       AND h.snap_id = st.snap_id
      JOIN dba_hist_sqltext txt
        ON txt.dbid = st.dbid
       AND txt.sql_id = st.sql_id
      WHERE txt.command_type IN (2, 6, 7, 189) -- INSERT, UPDATE, DELETE, MERGE
      GROUP BY st.dbid, st.sql_id, st.plan_hash_value
  )
  SELECT s.sql_id,
         s.plan_hash_value,
         s.parsing_schema,
         s.module,
         s.executions,
         s.rows_processed,
         ROUND(s.physical_write_bytes / 1024 / 1024, 2) AS physical_write_mb,
