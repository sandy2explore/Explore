       t.avg_active_sessions,
       TO_CHAR(t.first_seen, 'YYYY-MM-DD HH24:MI:SS') AS first_seen,
       TO_CHAR(t.last_seen, 'YYYY-MM-DD HH24:MI:SS') AS last_seen,
       NVL(c.current_running_sessions, 0) AS current_running_sessions,
       CASE
           WHEN c.max_last_call_et IS NULL THEN 'not running'
           ELSE
               FLOOR(c.max_last_call_et / 3600) || 'h ' ||
               FLOOR(MOD(c.max_last_call_et, 3600) / 60) || 'm ' ||
               MOD(c.max_last_call_et, 60) || 's'
       END AS max_current_running_for
   FROM
       top_sql t
       JOIN sql_details d
           ON d.sql_id = t.sql_id
           AND d.detail_rank = 1
       LEFT JOIN sql_inst i
           ON i.sql_id = t.sql_id
       LEFT JOIN current_sessions c
           ON c.sql_id = t.sql_id
   WHERE
       t.sql_rank <= 10
   ORDER BY
       t.sql_rank;
	   



