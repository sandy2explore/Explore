COLUMN top_wait_event     FORMAT A35
COLUMN distinct_plans     FORMAT 999
COLUMN plan_hash_values   FORMAT A60
COLUMN avg_elapsed_sec    FORMAT A14
COLUMN avg_cpu_sec        FORMAT A14
COLUMN first_load_time    FORMAT A22
COLUMN avg_buffer_gets    FORMAT 9999999999

WITH ash_data AS (
    SELECT sql_id, inst_id, NVL(event,'ON CPU') AS event, wait_class,
           COUNT(*) AS sample_count
    FROM gv$active_session_history
    WHERE sample_time >= SYSTIMESTAMP - INTERVAL '15' MINUTE
      AND sample_time <  SYSTIMESTAMP
      AND sql_id IS NOT NULL
    GROUP BY sql_id, inst_id, event, wait_class
),
sql_summary AS (
    SELECT sql_id,
           LISTAGG(DISTINCT TO_CHAR(inst_id), ',')
               WITHIN GROUP (ORDER BY inst_id)     AS instances,
           SUM(sample_count)                        AS total_samples,
           ROUND(SUM(sample_count) / (15 * 60), 3) AS total_aas,
           ROUND((SUM(sample_count) / (15 * 60) /
               (SELECT TO_NUMBER(VALUE) FROM v$parameter
                WHERE name = 'cpu_count' AND ROWNUM = 1)) * 100, 2) AS aas_percentage
    FROM ash_data
    GROUP BY sql_id
),
total_activity AS (
    SELECT SUM(sample_count) AS total_db_samples FROM ash_data
),
top_wait_per_sql AS (
    SELECT sql_id, event AS top_wait_event
    FROM (
        SELECT sql_id, event, SUM(sample_count) AS s,
               ROW_NUMBER() OVER (PARTITION BY sql_id
                   ORDER BY SUM(sample_count) DESC) AS rn
        FROM ash_data
        GROUP BY sql_id, event
    )
    WHERE rn = 1
),
exec_summary AS (
    SELECT sql_id,
           SUM(executions)                                             AS total_executions,
           COUNT(DISTINCT plan_hash_value)                             AS distinct_plans,
           LISTAGG(DISTINCT TO_CHAR(plan_hash_value), ', ') WITHIN GROUP (ORDER BY plan_hash_value)                 AS plan_hash_values,
           TO_CHAR(ROUND(SUM(elapsed_time) / NULLIF(SUM(executions),0)/ 1e6, 4), '999990.9999')                               AS avg_elapsed_sec,
           TO_CHAR(ROUND(SUM(cpu_time)     / NULLIF(SUM(executions),0)/ 1e6, 4), '999990.9999')                               AS avg_cpu_sec,
           TO_CHAR(MIN(TO_DATE(first_load_time, 'YYYY-MM-DD/HH24:MI:SS')),
               'YYYY-MM-DD HH24:MI:SS')                                AS first_load_time,
           ROUND(SUM(buffer_gets) / NULLIF(SUM(executions), 0), 0)    AS avg_buffer_gets
    FROM gv$sql
    GROUP BY sql_id
),
ranked AS (
    SELECT
        s.sql_id,
        TO_CHAR(SYSTIMESTAMP - INTERVAL '15' MINUTE, 'HH24:MI:SS')
            || ' to ' || TO_CHAR(SYSTIMESTAMP, 'HH24:MI:SS')          AS time_window,
        s.total_aas,
        s.aas_percentage                                               AS aas_pct,
        ROUND((s.total_samples / t.total_db_samples) * 100, 2)        AS pct_of_total,
        s.total_samples                                                AS samples,
        s.instances,
        NVL(e.total_executions, 0)                                     AS executions,
        CASE
            WHEN w.top_wait_event = 'ON CPU'                 THEN '[CPU        ]'
            WHEN w.top_wait_event LIKE '%log file%'          THEN '[LOG I/O    ]'
            WHEN w.top_wait_event LIKE '%db file%'           THEN '[DISK I/O   ]'
            WHEN w.top_wait_event LIKE '%direct path%'       THEN '[DIRECT I/O ]'
            WHEN w.top_wait_event LIKE '%buffer%'            THEN '[BUFFER     ]'
            WHEN w.top_wait_event LIKE '%latch%'             THEN '[LATCH      ]'
            WHEN w.top_wait_event LIKE '%enq%'               THEN '[ENQUEUE    ]'
            WHEN w.top_wait_event LIKE '%lock%'              THEN '[LOCK       ]'
            WHEN w.top_wait_event LIKE '%cursor%'            THEN '[CONCURRENCY]'
            WHEN w.top_wait_event LIKE '%library cache%'     THEN '[LIB CACHE  ]'
            WHEN w.top_wait_event LIKE '%row cache%'         THEN '[ROW CACHE  ]'
            WHEN w.top_wait_event LIKE '%SQL*Net%'           THEN '[NETWORK    ]'
            WHEN w.top_wait_event LIKE '%Streams%'           THEN '[STREAMS    ]'
            WHEN w.top_wait_event LIKE '%parallel%'          THEN '[PARALLEL   ]'
            WHEN w.top_wait_event LIKE '%PX%'                THEN '[PARALLEL   ]'
            WHEN w.top_wait_event LIKE '%undo%'              THEN '[UNDO       ]'
            WHEN w.top_wait_event LIKE '%flashback%'         THEN '[FLASHBACK  ]'
            WHEN w.top_wait_event IS NULL                    THEN '[UNKNOWN    ]'
            ELSE                                                  '[OTHER      ]'
        END                                                            AS wait_category,
        NVL(w.top_wait_event, 'N/A')                                   AS top_wait_event,
        NVL(e.distinct_plans,   0)                                     AS distinct_plans,
        NVL(e.plan_hash_values, 'N/A')                                 AS plan_hash_values,
        NVL(e.avg_elapsed_sec,  'N/A')                                 AS avg_elapsed_sec,
        NVL(e.avg_cpu_sec,      'N/A')                                 AS avg_cpu_sec,
        NVL(e.first_load_time,  'N/A')                                 AS first_load_time,
        NVL(e.avg_buffer_gets,  0)                                     AS avg_buffer_gets,
        ROW_NUMBER() OVER (ORDER BY s.aas_percentage DESC)             AS rn
    FROM sql_summary s
    CROSS JOIN total_activity t
    LEFT JOIN exec_summary     e ON s.sql_id = e.sql_id
    LEFT JOIN top_wait_per_sql w ON s.sql_id = w.sql_id
    WHERE s.aas_percentage > 2
)
SELECT
    sql_id, time_window, total_aas, aas_pct, pct_of_total,
    samples, instances, executions,
    wait_category, top_wait_event,
    distinct_plans, plan_hash_values,
    avg_elapsed_sec, avg_cpu_sec,
    first_load_time, avg_buffer_gets
FROM ranked
WHERE rn <= &topn
ORDER BY aas_pct DESC;









