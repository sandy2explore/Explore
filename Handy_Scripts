procedure ess_schjob_proc
( ess_schema in varchar2,
  request_id in number,
  request_handle in varchar2,
  request_proc in varchar2 )
authid current_user
as
  v_stmt varchar2(300);
  v_qual_reqproc varchar2(300) := null;
  p_error_code integer;
  p_error_msg varchar2(500);
begin
  ess_job.initialize_sql_job_session(request_handle);

  begin
    v_qual_reqproc := SYS.DBMS_ASSERT.qualified_sql_name(request_proc);
    v_stmt := 'begin ' || v_qual_reqproc || '(:1); end;';
    execute immediate v_stmt using request_handle;
    commit;
  exception
    when others then
      -- save error info and then rollback current txn
      ess_job.set_sql_exec_error;
      rollback;

      -- clean up session support and fail scheduler job
      ess_job.build_scheduler_error(p_error_code, p_error_msg);
      ess_job.terminate_sql_job_session;
      raise_application_error(p_error_code, p_error_msg);
  end;

  ess_job.terminate_sql_job_session;
end ess_schjob_proc;







