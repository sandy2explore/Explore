  with ic as (
      select inst_id,
             listagg(
                 name || '(' || ip_address || ',public=' || nvl(is_public,'?') || ',src=' || source || ')',
                 '; '
             ) within group (order by name) as interfaces,
             max(case when is_public = 'YES' then 1 else 0 end) as has_public
      from gv$cluster_interconnects
      group by inst_id
  ),
  st as (
      select inst_id,
             sum(case when lower(name) = 'global cache cr block receive time'      then value else 0 end) as cr_recv_time,
             sum(case when lower(name) = 'global cache cr blocks received'         then value else 0 end) as cr_blocks_recv,
             sum(case when lower(name) = 'global cache current block receive time' then value else 0 end) as cur_recv_time,
             sum(case when lower(name) = 'global cache current blocks received'    then value else 0 end) as cur_blocks_recv,
             sum(case when lower(name) = 'global cache cr timeouts'                then value else 0 end) as cr_timeouts,
             sum(case when lower(name) = 'global cache blocks lost'                then value else 0 end) as blocks_lost,
             sum(case when lower(name) = 'global cache blocks corrupted'           then value else 0 end) as blocks_corrupted
      from gv$sysstat
      group by inst_id
  ),
  ev as (
      select inst_id,
             sum(case when lower(event) like 'gc%block lost'      then total_waits else 0 end) as lost_waits,
             sum(case when lower(event) like 'gc%block congested' then total_waits else 0 end) as congested_waits
      from gv$system_event
      group by inst_id
  ),
  metric_src as (
      select inst_id,
             metric_name,
             value,
             begin_time,
             end_time,
             intsize_csec,
             row_number() over (
                 partition by inst_id, lower(metric_name)
                 order by end_time desc, intsize_csec desc
             ) as rn
      from gv$sysmetric
      where lower(metric_name) like '%interconnect%traffic%'
         or lower(metric_name) like '%gc cr blocks received%'
         or lower(metric_name) like '%gc current blocks received%'
  ),
  met as (
      select inst_id,
             max(case when lower(metric_name) like '%interconnect%traffic%'      then value end) as interconnect_mb_s,
             max(case when lower(metric_name) like '%gc cr blocks received%'     then value end) as gc_cr_blocks_recv_s,
             max(case when lower(metric_name) like '%gc current blocks received%' then value end) as gc_cur_blocks_recv_s,
             max(begin_time) as metric_begin_time,
             max(end_time)   as metric_end_time
      from metric_src
      where rn = 1
      group by inst_id
  )
  select i.inst_id,
         i.instance_name,
         i.host_name,
         to_char(i.startup_time, 'yyyy-mm-dd hh24:mi:ss') as startup_time,
         nvl(ic.interfaces, '<not visible in gv$cluster_interconnects>') as interfaces,
         round((st.cr_recv_time  * 10) / nullif(st.cr_blocks_recv, 0), 2) as avg_gc_cr_recv_ms,
