 DEFINE begin_time = '2026-07-15 07:18:00'
 DEFINE end_time   = '2026-07-15 07:22:00'
 
 
 
COL final_blocker     FORMAT A28
COL wait_class        FORMAT A18
COL wait_event        FORMAT A45
COL first_seen        FORMAT A22
COL last_seen         FORMAT A22
COL waiter_count      FORMAT 999999
COL ash_samples       FORMAT 999999
COL approx_wait_secs  FORMAT 999999999
COL max_chain_depth   FORMAT 999

WITH
params AS (
    SELECT dbid,
           TO_TIMESTAMP('&begin_time', 'YYYY-MM-DD HH24:MI:SS') begin_ts,
           TO_TIMESTAMP('&end_time',   'YYYY-MM-DD HH24:MI:SS') end_ts
    FROM v$database
),
snaps AS (
    SELECT /*+ MATERIALIZE */
           s.dbid,
           s.instance_number,
           s.snap_id
    FROM dba_hist_snapshot s
    JOIN params p
      ON p.dbid = s.dbid
    WHERE s.begin_interval_time < p.end_ts
      AND s.end_interval_time   > p.begin_ts
),
ash_links AS (
    SELECT /*+ MATERIALIZE */
           a.dbid,
           a.instance_number,
           a.snap_id,
           a.sample_id,
           a.sample_time,
           a.session_id,
           a.session_serial#,
           a.sql_id,
           a.event,
           a.wait_class,
           NVL(a.blocking_inst_id, a.instance_number) blocking_inst_id,
           a.blocking_session,
           a.blocking_session_serial#,
           a.blocking_session_status
    FROM dba_hist_active_sess_history a
    JOIN snaps s
      ON s.dbid            = a.dbid
     AND s.instance_number = a.instance_number
     AND s.snap_id         = a.snap_id
    JOIN params p
      ON p.dbid = a.dbid
    WHERE a.sample_time >= p.begin_ts
      AND a.sample_time <  p.end_ts
      AND a.session_state = 'WAITING'
      AND a.wait_class   <> 'Idle'
      AND a.blocking_session_status = 'VALID'
      AND a.blocking_session IS NOT NULL
),
chain (
    dbid,
    sample_id,
    sample_time,
    waiter_inst_id,
    waiter_sid,
    waiter_serial#,
    waiter_sql_id,
    wait_event,
    wait_class,
    blocker_inst_id,
    blocker_sid,
    blocker_serial#,
    chain_depth,
    chain_path
) AS (
    SELECT
           w.dbid,
           w.sample_id,
           w.sample_time,
           w.instance_number,
           w.session_id,
           w.session_serial#,
           w.sql_id,
           w.event,
           w.wait_class,
           w.blocking_inst_id,
           w.blocking_session,
           w.blocking_session_serial#,
           1,
           '/' || w.instance_number || ':' || w.session_id || ',' ||
           NVL(TO_CHAR(w.session_serial#), '?') || '/' ||
           w.blocking_inst_id || ':' || w.blocking_session || ',' ||
           NVL(TO_CHAR(w.blocking_session_serial#), '?') || '/'
    FROM ash_links w

    UNION ALL

    SELECT
           c.dbid,
           c.sample_id,
           c.sample_time,
           c.waiter_inst_id,
           c.waiter_sid,
           c.waiter_serial#,
           c.waiter_sql_id,
           c.wait_event,
           c.wait_class,
           b.blocking_inst_id,
           b.blocking_session,
           b.blocking_session_serial#,
           c.chain_depth + 1,
           c.chain_path ||
           b.blocking_inst_id || ':' || b.blocking_session || ',' ||
           NVL(TO_CHAR(b.blocking_session_serial#), '?') || '/'
    FROM chain c
    JOIN ash_links b
      ON b.dbid = c.dbid
     AND b.instance_number = c.blocker_inst_id
     AND b.session_id = c.blocker_sid
     AND NVL(b.session_serial#, -1) = NVL(c.blocker_serial#, -1)
     AND b.sample_time >= c.sample_time - INTERVAL '1' SECOND
     AND b.sample_time <  c.sample_time + INTERVAL '1' SECOND
    WHERE c.chain_depth < 10
      AND INSTR(
            c.chain_path,
            '/' || b.blocking_inst_id || ':' || b.blocking_session || ',' ||
            NVL(TO_CHAR(b.blocking_session_serial#), '?') || '/'
          ) = 0
),
final_per_waiter_sample AS (
    SELECT c.*,
           ROW_NUMBER() OVER (
             PARTITION BY dbid, sample_id, sample_time,
                          waiter_inst_id, waiter_sid, waiter_serial#
             ORDER BY chain_depth DESC
           ) rn
    FROM chain c
)
SELECT
       blocker_inst_id || ':' || blocker_sid || ',' ||
       NVL(TO_CHAR(blocker_serial#), '?') AS final_blocker,
       wait_class,
       wait_event,
       TO_CHAR(MIN(sample_time), 'YYYY-MM-DD HH24:MI:SS') first_seen,
       TO_CHAR(MAX(sample_time), 'YYYY-MM-DD HH24:MI:SS') last_seen,
       COUNT(DISTINCT waiter_inst_id || ':' || waiter_sid || ',' || waiter_serial#) waiter_count,
       COUNT(*) ash_samples,
       COUNT(*) * 10 approx_wait_secs,
       MAX(chain_depth) max_chain_depth
FROM final_per_waiter_sample
WHERE rn = 1
GROUP BY
       blocker_inst_id,
       blocker_sid,
       blocker_serial#,
       wait_class,
       wait_event
ORDER BY ash_samples DESC, waiter_count DESC, first_seen;



