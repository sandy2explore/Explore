           ROUND(SUM(DECODE(dbf.autoextensible,'NO',dbf.bytes,'YES',dbf.maxbytes)) / 1024 / 1024 / 1024,2) TOTAL_SIZ_GB,
           (
            SELECT ROUND(SUM(bytes / 1024 / 1024 / 1024), 2)
              FROM dba_segments
             WHERE tablespace_name = dbf.tablespace_name
           ) USED_SPACE_GB
      FROM dba_data_files dbf
     WHERE dbf.tablespace_name IN (SELECT value FROM v$parameter WHERE lower(name) = 'undo_tablespace')
     GROUP BY dbf.tablespace_name
              )
SELECT
