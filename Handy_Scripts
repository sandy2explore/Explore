  INTERCONNECT LATENCY / GC WAITS 
  
  
  -- One-shot RAC GC diagnostic: hot block vs interconnect latency
  -- Bind variables:
  --   :from_ts  start timestamp
  --   :to_ts    end timestamp

  WITH ash AS (
      SELECT
          sql_id,
          current_obj#,
          current_file#,
          current_block#,
          event,
          session_state,
          time_waited
      FROM gv$active_session_history
      WHERE sample_time between to_date('2026/04/12 05:00:00','yyyy/mm/dd hh24:mi:ss') and to_date('2026/04/12 06:05:00','yyyy/mm/dd hh24:mi:ss')
        AND event IN (
            'gc cr block busy',
            'gc current block busy',
            'gc cr block 2-way',
            'gc current block 2-way',
            'gc cr block 3-way',
            'gc current block 3-way'
        )
  ),
  agg AS (
      SELECT
          sql_id,
          current_obj#,
          current_file#,
          current_block#,
          COUNT(*) AS ash_samples,
          SUM(CASE
                WHEN event IN ('gc cr block busy', 'gc current block busy') THEN 1
                ELSE 0
              END) AS busy_samples,
          SUM(CASE
                WHEN event IN ('gc cr block 2-way', 'gc current block 2-way',
                               'gc cr block 3-way', 'gc current block 3-way') THEN 1
                ELSE 0
              END) AS transfer_samples,
          ROUND(AVG(CASE WHEN session_state = 'WAITING' THEN time_waited END) / 1000, 2) AS avg_wait_ms
      FROM ash
      GROUP BY sql_id, current_obj#, current_file#, current_block#
  ),
  scored AS (
      SELECT
          a.*,
          ROUND(100 * a.busy_samples / NULLIF(a.ash_samples, 0), 1) AS busy_pct,
          ROUND(100 * a.transfer_samples / NULLIF(a.ash_samples, 0), 1) AS transfer_pct,
          ROUND(100 * a.ash_samples / SUM(a.ash_samples) OVER (PARTITION BY a.sql_id), 1) AS sql_block_share_pct,
          CASE
              WHEN (100 * a.busy_samples / NULLIF(a.ash_samples, 0) >= 60)
                OR (100 * a.ash_samples / SUM(a.ash_samples) OVER (PARTITION BY a.sql_id) >= 40)
              THEN 'HOT BLOCK / CONTENTION'
              WHEN (100 * a.transfer_samples / NULLIF(a.ash_samples, 0) >= 70)
               AND (a.avg_wait_ms >= 3)
              THEN 'INTERCONNECT / LATENCY'
              ELSE 'MIXED / NEED MORE DATA'
          END AS diagnosis
      FROM agg a
  )
  SELECT
      s.diagnosis,
      s.sql_id,
      s.current_obj#,
      o.owner,
      o.object_name,
      o.object_type,
      s.current_file#,
      s.current_block#,
      e.segment_name,
      e.segment_type,
      e.partition_name,
      s.ash_samples,
      s.busy_samples,
      s.transfer_samples,
      s.busy_pct,
      s.transfer_pct,
      s.sql_block_share_pct,
      s.avg_wait_ms
  FROM scored s
  LEFT JOIN dba_objects o
         ON o.object_id = s.current_obj#
  LEFT JOIN dba_extents e
         ON e.file_id = s.current_file#
        AND s.current_block# BETWEEN e.block_id AND e.block_id + e.blocks - 1
  ORDER BY s.ash_samples DESC, s.avg_wait_ms DESC
  FETCH FIRST 20 ROWS ONLY;
  
  
 
 
