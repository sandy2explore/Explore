 WITH sql_stats AS (
       SELECT
           inst_id,
           sql_id,
           plan_hash_value,
           SUM(executions)         AS tot_exec,
           SUM(buffer_gets)        AS buffer_gets,
           SUM(rows_processed)     AS rows_processed,
           SUM(elapsed_time) / 1e6 AS tot_elap_sec,
           SUM(cpu_time)     / 1e6 AS tot_cpu_sec
       FROM gv$sql
       GROUP BY
           inst_id,
           sql_id,
           plan_hash_value
   ),
   plan_objects AS (
       SELECT DISTINCT
           inst_id,
           sql_id,
           plan_hash_value,
           object_owner,
           object_name,
           operation
       FROM gv$sql_plan
       WHERE object_owner = UPPER('&obj_owner')
         AND object_name  = UPPER('&obj_name')
   )
   SELECT
       p.sql_id,
       p.plan_hash_value,
       p.object_owner,
       p.object_name,
       p.operation,
       SUM(s.tot_exec)        AS tot_exec,
       SUM(s.buffer_gets)     AS buffer_gets,
       SUM(s.rows_processed)  AS rows_processed,
       ROUND(SUM(s.tot_elap_sec), 2) AS tot_elap_sec,
       ROUND(SUM(s.tot_cpu_sec), 2)  AS tot_cpu_sec
   FROM plan_objects p
   JOIN sql_stats s
     ON s.inst_id         = p.inst_id
    AND s.sql_id          = p.sql_id
    AND s.plan_hash_value = p.plan_hash_value
   GROUP BY
       p.sql_id,
       p.plan_hash_value,
       p.object_owner,
       p.object_name,
       p.operation
   ORDER BY tot_exec DESC;
   
   
