    end_interval_time,
    executions_delta,
    round(elapsed_time_delta /(nonzeroexecutions * 1000), 1) "Elapsed Avg ms",
    round(cpu_time_delta /(nonzeroexecutions * 1000), 1)     "CPU Avg ms",
    round(iowait_delta /(nonzeroexecutions * 1000), 1)       "IO Avg ms",
    round(buffer_gets_delta /(nonzeroexecutions * 1000), 1)  "Avg Buffer Gets",
