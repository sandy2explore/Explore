 with
 params as (
   select numtodsinterval(120, 'MINUTE') as corr_window
   from dual
 ),
 incidents as (
   select 'INC_2026_04_24_0115' as incident_id,to_timestamp_tz('2026-04-24 01:15:00 +05:30','YYYY-MM-DD HH24:MI:SS TZH:TZM') as incident_time from dual
   union all
   select 'INC_2026_04_24_0330',to_timestamp_tz('2026-04-24 03:30:00 +05:30','YYYY-MM-DD HH24:MI:SS TZH:TZM') from dual
 ),
 snapshots as (
   select s.dbid,
          s.instance_number,
          s.snap_id,
          s.startup_time,
          s.end_interval_time_tz
   from   dba_hist_snapshot s
   where  s.end_interval_time_tz >= (
            select min(incident_time) - numtodsinterval(1, 'DAY') from incidents
			)
   and    s.end_interval_time_tz <= (
            select max(incident_time) + numtodsinterval(1, 'DAY') from incidents
          )
 ),
 param_history as (
   select s.end_interval_time_tz as event_time,
          p.instance_number,
          p.con_id,
          p.parameter_name,
          lag(p.value) over (
            partition by p.dbid, p.instance_number, p.con_id, p.parameter_name, s.startup_time
            order by s.end_interval_time_tz
          ) as prev_value,
          p.value as new_value,
          p.ismodified,
          p.isdefault
   from   dba_hist_parameter p
   join   snapshots s
     on   s.dbid = p.dbid
    and   s.instance_number = p.instance_number
    and   s.snap_id = p.snap_id
 ),
 param_events as (
   select event_time,
          'PARAMETER' as event_type,
          instance_number,
          con_id,
          parameter_name as subject,
          'CHANGED' as status,
          'old=' || substr(prev_value, 1, 200) ||
          ' ; new=' || substr(new_value, 1, 200) ||
          ' ; ismodified=' || ismodified ||
          ' ; isdefault=' || isdefault as details
   from   param_history
   where  nvl(prev_value, '<NULL>') <> nvl(new_value, '<NULL>')
 ),
 optstat_events as (
   select o.start_time as event_time,
          'OPTSTAT' as event_type,
          cast(null as number) as instance_number,
          cast(null as number) as con_id,
          o.target as subject,
          o.status,
          'operation=' || o.operation ||
          ' ; job=' || nvl(o.job_name, '-') ||
          ' ; end=' || to_char(o.end_time, 'YYYY-MM-DD HH24:MI:SS TZH:TZM') ||
          ' ; notes=' || substr(o.notes, 1, 500) as details
   from   dba_optstat_operations o
 ),
 autotask_job_events as (
   select h.job_start_time as event_time,
          'AUTO_TASK' as event_type,
          cast(null as number) as instance_number,
          cast(null as number) as con_id,
          h.client_name || ' / ' || h.window_name as subject,
          h.job_status as status,
          'job=' || h.job_name ||
          ' ; error=' || nvl(to_char(h.job_error), '-') ||
          ' ; info=' || substr(h.job_info, 1, 500) as details
   from   dba_autotask_job_history h
 ),
 maint_window_events as (
   select w.window_start_time as event_time,
          'MAINT_WINDOW' as event_type,
          cast(null as number) as instance_number,
          cast(null as number) as con_id,
          w.window_name as subject,
          case when w.window_end_time is null then 'OPEN' else 'CLOSED' end as status,
          'window_end=' || to_char(w.window_end_time, 'YYYY-MM-DD HH24:MI:SS TZH:TZM') as details
   from   dba_autotask_window_history w
 ),
 sqlpatch_events as (
   select from_tz(cast(p.action_time as timestamp), sessiontimezone) as event_time,
          'SQLPATCH' as event_type,
          cast(null as number) as instance_number,
          cast(null as number) as con_id,
          p.description as subject,
          p.status,
          'action=' || p.action ||
          ' ; patch_id=' || p.patch_id ||
          ' ; patch_uid=' || p.patch_uid ||
          ' ; logfile=' || p.logfile as details
   from   dba_registry_sqlpatch p
 ),
 registry_events as (
   select from_tz(cast(r.action_time as timestamp), sessiontimezone) as event_time,
          'REGISTRY' as event_type,
          cast(null as number) as instance_number,
          cast(null as number) as con_id,
          r.namespace as subject,
          r.action as status,
          'version=' || r.version ||
          ' ; id=' || r.id ||
          ' ; comments=' || r.comments as details
   from   dba_registry_history r
 ),
 deploy_events as (
   select cast(null as timestamp with time zone) as event_time,
          cast(null as varchar2(30)) as event_type,
          cast(null as number) as instance_number,
          cast(null as number) as con_id,
          cast(null as varchar2(4000)) as subject,
          cast(null as varchar2(4000)) as status,
          cast(null as varchar2(4000)) as details
   from dual
   where 1 = 0
 ),
 events as (
   select * from param_events
   union all
   select * from optstat_events
   union all
   select * from autotask_job_events
   union all
   select * from maint_window_events
   union all
   select * from sqlpatch_events
   union all
   select * from registry_events
   union all
   select * from deploy_events
 ),
 correlated as (
   select i.incident_id,
          i.incident_time,
          e.event_time,
          round(
            (extract(day from (e.event_time - i.incident_time)) * 1440 + extract(hour   from (e.event_time - i.incident_time)) * 60 + extract(minute from (e.event_time - i.incident_time)) +extract(second from (e.event_time - i.incident_time)) / 60), 2) as minutes_from_incident,
          e.event_type,
          e.instance_number,
          e.con_id,
          e.subject,
          e.status,
          e.details
   from   incidents i
   join   events e
     on   e.event_time between i.incident_time - (select corr_window from params)
    and i.incident_time + (select corr_window from params)
 )
 select incident_id,
        incident_time,
        event_time,
        minutes_from_incident,
        event_type,
        instance_number,
        con_id,
        subject,
        status,
        details
 from   correlated
 order  by incident_time, abs(minutes_from_incident), event_type, subject;
   
   
   
 
