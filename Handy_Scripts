),
pct AS (
    SELECT obj_name,
           round(percentile_disc(0.50) within group (order by cpu_consumed), 2) AS cpu_p50,
           round(percentile_disc(0.70) within group (order by cpu_consumed), 2) AS cpu_p70,
           round(percentile_disc(0.80) within group (order by cpu_consumed), 2) AS cpu_p80,
