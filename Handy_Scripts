WITH sp AS (
    SELECT 
        SUM(CASE WHEN name = 'free memory' THEN bytes END) AS free_bytes,
        SUM(CASE WHEN name <> 'free memory' THEN bytes END) AS used_bytes
    FROM v$sgastat
    WHERE pool = 'shared pool'
),
lp AS (
    SELECT 
        SUM(CASE WHEN name = 'free memory' THEN bytes END) AS free_bytes,
        SUM(CASE WHEN name <> 'free memory' THEN bytes END) AS used_bytes
    FROM v$sgastat
    WHERE pool = 'large pool'
),
sp_total AS (
    SELECT bytes AS total_bytes
    FROM v$sgainfo
    WHERE name = 'Shared Pool Size'
),
lp_total AS (
    SELECT bytes AS total_bytes
    FROM v$sgainfo
    WHERE name = 'Large Pool Size'
),
sp_resize AS (
    SELECT 
        COUNT(*) AS total_ops,
        SUM(CASE WHEN status = 'FAILED' THEN 1 END) AS failed_ops
    FROM v$memory_resize_ops
    WHERE component = 'shared pool'
),
lp_resize AS (
    SELECT 
        COUNT(*) AS total_ops,
        SUM(CASE WHEN status = 'FAILED' THEN 1 END) AS failed_ops
    FROM v$memory_resize_ops
    WHERE component = 'large pool'
)
SELECT
    -- Shared Pool
    ROUND(sp.free_bytes/1024/1024) AS SP_FREE_MB,
    ROUND(sp_total.total_bytes/1024/1024) AS SP_TOTAL_MB,
    ROUND((sp.free_bytes/sp_total.total_bytes)*100,2) AS SP_FREE_PCT,
    sp_resize.total_ops AS SP_RESIZE_TOTAL_OPS,
    NVL(sp_resize.failed_ops,0) AS SP_RESIZE_FAILED_OPS,
    CASE
        WHEN (sp.used_bytes/sp_total.total_bytes)*100 > 95 AND NVL(sp_resize.failed_ops,0) > 0
            THEN 'VERY HIGH RISK (>95% + resize failures)'
        WHEN (sp.used_bytes/sp_total.total_bytes)*100 > 90 THEN 'HIGH RISK (>90% usage)'
        ELSE 'NORMAL'
    END AS SP_RISK_LEVEL,
    -- Large Pool
    ROUND(lp.free_bytes/1024/1024) AS LP_FREE_MB,
    ROUND(lp_total.total_bytes/1024/1024) AS LP_TOTAL_MB,
    ROUND((lp.free_bytes/lp_total.total_bytes)*100,2) AS LP_FREE_PCT,
    lp_resize.total_ops AS LP_RESIZE_TOTAL_OPS,
    NVL(lp_resize.failed_ops,0) AS LP_RESIZE_FAILED_OPS,
    CASE
        WHEN (lp.used_bytes/lp_total.total_bytes)*100 > 95 AND NVL(lp_resize.failed_ops,0) > 0
            THEN 'VERY HIGH RISK (>95% + resize failures)'
        WHEN (lp.used_bytes/lp_total.total_bytes)*100 > 90 THEN 'HIGH RISK (>90% usage)'
        ELSE 'NORMAL'
    END AS LP_RISK_LEVEL
FROM sp, lp, sp_total, lp_total, sp_resize, lp_resize;


  
