SELECT * FROM (
    SELECT 
        stat.sql_id,
        SUM(stat.executions_delta) AS total_executions,
        SUM(stat.db_block_changes_delta) AS total_block_changes,
        ROUND(SUM(stat.db_block_changes_delta * p.value) / 1024 / 1024, 2) AS total_estimated_redo_mb,
        ROUND(SUM(stat.db_block_changes_delta * p.value) / NVL(NULLIF(SUM(stat.executions_delta), 0), 1) / 1024 / 1024, 4) AS redo_per_exec_mb
    FROM 
        dba_hist_sqlstat stat
    CROSS JOIN 
        (SELECT value FROM v$parameter WHERE name = 'db_block_size') p
    GROUP BY 
        stat.sql_id, p.value
    ORDER BY 
        total_estimated_redo_mb DESC
)
WHERE ROWNUM <= 10;





