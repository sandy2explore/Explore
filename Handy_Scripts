        SUM(NVL(ss.invalidations_delta, 0)) AS invalidations_delta,
        SUM(NVL(ss.buffer_gets_delta, 0)) AS buffer_gets_delta,
        SUM(NVL(ss.disk_reads_delta, 0)) AS disk_reads_delta,
        SUM(NVL(ss.cpu_time_delta, 0)) AS cpu_time_us,
        SUM(NVL(ss.elapsed_time_delta, 0)) AS elapsed_time_us
    FROM dba_hist_sqlstat ss
    JOIN dba_hist_snapshot sn
        ON sn.dbid = ss.dbid
       AND sn.snap_id = ss.snap_id
       AND sn.instance_number = ss.instance_number
    WHERE sn.begin_interval_time >= TRUNC(SYSDATE) - 9
      AND sn.begin_interval_time <  TRUNC(SYSDATE) + 1
      AND ss.sql_id IS NOT NULL
    GROUP BY
        TRUNC(sn.begin_interval_time),
        ss.dbid,
        ss.instance_number,
        ss.snap_id,
        ss.sql_id
),
per_day AS (
    SELECT
        snap_day,
        dbid,
        instance_number,
        sql_id,
        MAX(parsing_schema_name) AS parsing_schema_name,
        MAX(module) AS module,
        ROUND(AVG(sharable_mem_bytes) / 1024 / 1024, 2) AS avg_shared_pool_mb,
        ROUND(MAX(sharable_mem_bytes) / 1024 / 1024, 2) AS max_shared_pool_mb,
        ROUND(AVG(version_count), 2) AS avg_version_count,
        MAX(version_count) AS max_version_count,
        SUM(executions_delta) AS executions,
        SUM(parse_calls_delta) AS parse_calls,
        SUM(loads_delta) AS loads,
        SUM(invalidations_delta) AS invalidations,
        SUM(buffer_gets_delta) AS buffer_gets,
        SUM(disk_reads_delta) AS disk_reads,
        ROUND(SUM(cpu_time_us) / 1000000, 2) AS cpu_sec,
        ROUND(SUM(elapsed_time_us) / 1000000, 2) AS elapsed_sec
    FROM per_snap
    GROUP BY
        snap_day,
        dbid,
        instance_number,
        sql_id
),
ranked AS (
    SELECT
        p.*,
        ROW_NUMBER() OVER (
            PARTITION BY snap_day, instance_number
            ORDER BY max_shared_pool_mb DESC, avg_shared_pool_mb DESC
        ) AS rn
    FROM per_day p
)
