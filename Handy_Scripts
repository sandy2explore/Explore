         AND ash.sql_id IS NOT NULL
       GROUP BY
           ash.dbid,
           ash.sql_id,
           NVL(ash.module,  '<NULL>'),
           NVL(ash.program, '<NULL>')
   ),
   elapsed AS (
       SELECT (end_time - begin_time) * 86400 AS elapsed_secs
       FROM params
   )
   SELECT
       a.sql_id,
       a.module,
       a.program,
       SUBSTR(s.sql_text, 1, 1000) AS sql_text,
       ROUND(a.db_time_secs / e.elapsed_secs, 3) AS avg_active_sessions,
