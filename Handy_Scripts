    SUM(CASE WHEN c.state = 12 THEN 1 ELSE 0 END) AS succeeded,
    SUM(CASE WHEN c.state <> 12 AND c.processend IS NOT NULL THEN 1 ELSE 0 END) AS error,
    TO_CHAR(MIN(c.processstart), 'MM/DD/YYYY HH24:MI:SS') AS start_date,
    TO_CHAR(MAX(c.processend),   'MM/DD/YYYY HH24:MI:SS') AS end_date,
    ROUND(
        (CAST(MAX(c.processend) AS DATE) - CAST(MIN(c.processstart) AS DATE)) * 24 * 60,
        2
    ) AS minutes
FROM request_history c
WHERE c.absparentid = 17185003
GROUP BY
    c.absparentid,
    c.name
ORDER BY
    MIN(c.processstart)
