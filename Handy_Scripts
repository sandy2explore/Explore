       WHEN ash.event LIKE 'gc %busy%'       THEN 'GC_BUSY'
       WHEN ash.event LIKE 'gc %grant%'      THEN 'GC_GRANT'
       WHEN ash.event LIKE 'gc %block%'      THEN 'GC_BLOCK'
       ELSE 'OTHER_GC'
     END AS gc_classification,
     ash.event,
     ash.wait_class,
     COUNT(*) AS ash_samples,
     ROUND(COUNT(*) / NULLIF(SUM(COUNT(*)) OVER (PARTITION BY ash.inst_id), 0) * 100, 2) AS pct_of_inst_gc_samples
 FROM gv$active_session_history ash
 WHERE ash.event LIKE 'gc%'
   AND ash.sql_id IS NOT NULL
 GROUP BY
     ash.inst_id,
     ash.sql_id,
     ash.module,
     ash.program,
     CASE
       WHEN ash.event IN (
         'gc cr request',
         'gc cr multi block request',
         'gc cr disk request'
       ) THEN 'GC_CR'
       WHEN ash.event IN (
         'gc current request',
         'gc current block busy',
         'gc current multi block request',
         'gc current retry'
       ) THEN 'GC_CURRENT'
       WHEN ash.event LIKE 'gc buffer busy%' THEN 'GC_BUFFER_BUSY'
       WHEN ash.event LIKE 'gc %busy%'       THEN 'GC_BUSY'
       WHEN ash.event LIKE 'gc %grant%'      THEN 'GC_GRANT'
       WHEN ash.event LIKE 'gc %block%'      THEN 'GC_BLOCK'
       ELSE 'OTHER_GC'
     END,
     ash.event,
     ash.wait_class
 ORDER BY PCT_OF_INST_GC_SAMPLES DESC
 FETCH FIRST 10 rows ONLY;
 
 


