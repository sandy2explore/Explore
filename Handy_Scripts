      st.pool,
      st.name,
      SUM(st.bytes) AS bytes                  -- sum across RAC instances
    FROM dba_hist_sgastat st
    JOIN dba_hist_snapshot sn
      ON sn.dbid            = st.dbid
     AND sn.snap_id         = st.snap_id
     AND sn.instance_number = st.instance_number
    WHERE st.pool = 'large pool'
      AND sn.begin_interval_time >= to_timestamp('2026-04-02 07:00:00','YYYY-MM-DD HH24:MI:SS')
      AND sn.begin_interval_time <  to_timestamp('2026-04-02 08:00:00','YYYY-MM-DD HH24:MI:SS')
    GROUP BY st.dbid, st.snap_id, sn.begin_interval_time, st.pool, st.name
  ),
  per_snap AS (
    SELECT
      TRUNC(begin_time, 'WW') AS week_begin,
      pool,
      /* Total Large Pool size at the snap (MB) */
      SUM(bytes)/1024/1024 AS tot_mb,
      /* SESSION_SIZE (MB): session heap usage in Large Pool */
      SUM(CASE WHEN LOWER(name) LIKE 'session heap%' THEN bytes ELSE 0 END)/1024/1024 AS session_size,
      /* MAX_VAL (MB): PX message buffers in Large Pool (adjust names if needed) */
      SUM(CASE WHEN LOWER(name) IN ('px msg pool','px messages') THEN bytes ELSE 0 END)/1024/1024 AS max_val
    FROM base
    GROUP BY dbid, snap_id, TRUNC(begin_time,'WW'), pool
  )
  SELECT
    week_begin                         AS "TRUNC(BEGIN_TIME,'WW')",
    pool                               AS "POOL",
    ROUND(MIN(tot_mb))                 AS "MIN(TOT_MB)",
    ROUND(MAX(tot_mb))                 AS "MAX(TOT_MB)",
    ROUND(AVG(session_size))           AS "ROUND(AVG(SESSION_SIZE))",
    ROUND(MAX(session_size), 2)        AS "MAX(SESSION_SIZE)",
    ROUND(MIN(max_val))                AS "MIN(MAX_VAL)",
    ROUND(AVG(max_val))                AS "ROUND(AVG(MAX_VAL))",
    ROUND(MAX(max_val))                AS "MAX(MAX_VAL)"
  FROM per_snap
  GROUP BY week_begin, pool
  ORDER BY week_begin, pool;
  
  
  
