(saas.fa_wls_server, saas.fa_wls_out) and ('BEA-090078' and 'security realm myrealm has had 5 invalid login attempts') | stats count as USERS_LOCKED_ERROR ], [ 'Log Source' = saas.db_alert and 'Entity Type' = 'Oracle Database Instance' and 'unable to extend' and 'Error ID' in ('ora-1653', 'ora-1683', 'ora-1691', 'ora-1693') | stats count as DB_TABLE_SPACE_ISSUE ]



