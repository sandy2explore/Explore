Madhav - 

col ERROR_CODE for a20
SELECT
    inst_id,REGEXP_SUBSTR(message_text, 'ORA-[0-9]+', 1, 1) AS ERROR_CODE,
    COUNT(*) AS ERR_COUNT,
    TO_CHAR(MIN(originating_timestamp), 'DD-MON-YYYY HH24:MI:SS') AS FIRST_SEEN_HR,
    TO_CHAR(MAX(originating_timestamp), 'DD-MON-YYYY HH24:MI:SS') AS LAST_SEEN_HR
FROM  X$DBGALERTEXT
WHERE originating_timestamp > SYSTIMESTAMP - INTERVAL '30' DAY -- Filter for the last 30 days
  AND REGEXP_LIKE(message_text, '(ORA-)', 'i') -- Filter for linesSQL>  containing 'ORA-' or 'error'
GROUP BY inst_id,REGEXP_SUBSTR(message_text, 'ORA-[0-9]+', 1, 1)
ORDER BY LAST_SEEN_HR DESC;


