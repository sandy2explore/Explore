Special Query to trace sid/serial for the ora error :
=====================================

WITH problem
     AS (SELECT Count(*) cnt
         FROM   v$diag_problem
         WHERE  Upper(problem_key) LIKE '%4031%'
                AND lastinc_time > SYSDATE - 1)
SELECT /*+  ORDERED leading(problem)  */
DISTINCT  
         alert.process_id,
         s.sid,
         s.serial# ,
		 alert.message_text
FROM   problem,
       v$diag_alert_ext alert,
       gv$process p,
       gv$session s
WHERE  cnt != 0
       AND Upper(alert.message_text) LIKE '%ORA-04031%'
       AND alert.originating_timestamp > SYSDATE - 1
       AND p.spid = alert.process_id
       AND p.addr = s.paddr;




