AWR SQL HISTORY PER DAY ::: awr_sql_history_per_day.sql
  
    COL day              FORMAT A12
    COL sql_id           FORMAT A13
    COL plan_hash_value  FORMAT 9999999999999999
    COL execs            FORMAT 999,999,999
    COL ela_sec          FORMAT 999,999,999.99
    COL cpu_sec          FORMAT 999,999,999.99
    COL io_sec           FORMAT 999,999,999.99
    COL gets             FORMAT 999,999,999,999
    COL reads            FORMAT 999,999,999,999
    COL rows_proc        FORMAT 999,999,999,999

    SELECT
        TO_CHAR(TRUNC(sn.begin_interval_time), 'DD-MON-YYYY') AS day,
        ss.sql_id,
        ss.plan_hash_value,
        SUM(NVL(ss.executions_delta,0))                AS execs,
        ROUND(SUM(NVL(ss.elapsed_time_delta,0))/1e6,2) AS ela_sec,
        ROUND(SUM(NVL(ss.cpu_time_delta,0))/1e6,2)     AS cpu_sec,
        ROUND(SUM(NVL(ss.iowait_delta,0))/1e6,2)       AS io_sec,
        SUM(NVL(ss.buffer_gets_delta,0))               AS gets,
        SUM(NVL(ss.disk_reads_delta,0))                AS reads,
        SUM(NVL(ss.rows_processed_delta,0))            AS rows_proc,
        ROUND(
            SUM(NVL(ss.elapsed_time_delta,0)) /
            NULLIF(SUM(NVL(ss.executions_delta,0)),0) / 1e6, 4
        ) AS avg_ela_per_exec_sec
    FROM dba_hist_sqlstat ss
    JOIN dba_hist_snapshot sn
      ON sn.snap_id = ss.snap_id
     AND sn.dbid = ss.dbid
     AND sn.instance_number = ss.instance_number
    WHERE sn.begin_interval_time >= TRUNC(SYSDATE) - 10
      AND ss.sql_id = '&sql_id'
    GROUP BY
        TRUNC(sn.begin_interval_time),
        ss.sql_id,
        ss.plan_hash_value
    ORDER BY
        TRUNC(sn.begin_interval_time) desc;



