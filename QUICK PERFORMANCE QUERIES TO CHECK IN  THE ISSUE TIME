-- active_session_profile.sql - Profile active sessions by event, program, module and sql_id
--
-- History:
--
--   20-Mar-2025 kgrauste - Created
--

column value format a50 wrap
break on category skip 1

define top_count = 5

with s as (
  select
    inst_id,
    type sesstype,
    decode(state, 'WAITING', event, 'CPU') event_or_cpu,
    decode(state, 'WAITING', wait_class, 'CPU') wait_class,
    program,
    module,
    sql_id,
    seconds_in_wait
  from gv$session
  where
    status = 'ACTIVE'
    and wait_class <> 'Idle'
),
a as (
  select
    'TOP_SYSCALLS' category,
    event_or_cpu value,
    count(*) session_count,
    rank() over (order by count(*) desc, event_or_cpu) category_rank
  from s
  group by event_or_cpu
  UNION ALL
  select
    'TOP_PROGRAMS' category,
    regexp_replace(regexp_replace(program, '_*([Ss]erver).*$', '\1'), 'DS/FADomain/', '') value,
    count(*) session_count,
    rank() over (order by count(*) desc, regexp_replace(regexp_replace(program, '_*([Ss]erver).*$', '\1'), 'DS/FADomain/', '')) category_rank
  from s
  group by regexp_replace(regexp_replace(program, '_*([Ss]erver).*$', '\1'), 'DS/FADomain/', '')
  UNION ALL
  select
    'TOP_MODULES' category,
    regexp_replace(regexp_replace(module, '_*([Ss]erver).*$', '\1'), 'DS/FADomain/', '') value,
    count(*) session_count,
    rank() over (order by count(*) desc, regexp_replace(regexp_replace(module, '_*([Ss]erver).*$', '\1'), 'DS/FADomain/', '')) category_rank
  from s
  where module is not null
  group by regexp_replace(regexp_replace(module, '_*([Ss]erver).*$', '\1'), 'DS/FADomain/', '')
  UNION ALL
  select
    'TOP_SQLIDS' category,
    sql_id value,
    count(*) session_count,
    rank() over (order by count(*) desc, sql_id) category_rank
  from s
  where sql_id is not null
  group by sql_id
)
select
  category, 
  value,
  session_count
from a
where category_rank <= &&top_count
order by category desc, session_count desc
/

undefine top_count
clear breaks

