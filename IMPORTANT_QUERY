SELECT QUEUE_NAME, SUBSCRIBER_NAME ,SUM(ENQUEUED_MSGS - DEQUEUED_MSGS) backlog  
from GV$PERSISTENT_SUBSCRIBERS st 
WHERE   queue_schema like '%FUSION%' 
  and  QUEUE_NAME like '%EDN%AQJMS%' 
GROUP BY QUEUE_NAME, SUBSCRIBER_NAME
having SUM(ENQUEUED_MSGS - DEQUEUED_MSGS) > 1000
order by backlog desc;



Historic - 
————

select sum(ENQUEUED_MSGS),sum(DEQUEUED_MSGS),to_char(sn.BEGIN_INTERVAL_TIME,'yy-mm-dd hh24') 
  from dba_hist_PERSISTENT_QUEUES ss,dba_hist_snapshot sn 
where QUEUE_NAME='ORASDPMENGINESNDT1' and QUEUE_SCHEMA='FUSION_ORASDPM'
   and ss.snap_id=sn.snap_id
   and ss.INSTANCE_NUMBER=sn.INSTANCE_NUMBER
   and sn.DBID=ss.DBID
   and sn.DBID=(select dbid from v$database)
   and sn.BEGIN_INTERVAL_TIME >= sysdate - 1
group by to_char(sn.BEGIN_INTERVAL_TIME,'yy-mm-dd hh24') order by 3;



