ORA-00020 - PROCESS UTILIZATION  - https://smarttechways.com/tag/get-history-of-resource-utilization-with-time/ 

col snapshottime for a20
col resource_name for a20
select s.SNAP_ID,b.INSTANCE_NUMBER,TO_CHAR(s.END_INTERVAL_TIME, 'DD-MON HH24:MI:SS') Snapshottime,resource_name,current_utilization,max_utilization,limit_value from DBA_HIST_SNAPSHOT s, DBA_HIST_RESOURCE_LIMIT b
where s.snap_id = b.snap_id and resource_name like '%process%'  and current_utilization > 9000 order by s.END_INTERVAL_TIME ;

