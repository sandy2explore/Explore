set lines 200
col QUEUE_NAME for a35
select QUEUE_NAME,
         sum(ENQUEUED_MSGS) TOTAL_ENQ_MULTI_SUB,
         sum(DEQUEUED_MSGS) TOTAL_DEQ_MULTI_SUB,
         sum(ENQUEUED_MSGS)-sum(DEQUEUED_MSGS) TOTAL_BACKLOG_MULTI_SUB
    from gv$persistent_subscribers
   group by QUEUE_NAME
   having sum(ENQUEUED_MSGS)-sum(DEQUEUED_MSGS)>0
   order by QUEUE_NAME;


