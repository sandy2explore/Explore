SELECT i.owner, i.index_name, i.table_owner, i.table_name, o.last_ddl_time, si.spare6 AS index_rebuild_dt 
  FROM dba_indexes i LEFT OUTER join dba_objects o 
    ON o.owner = i.owner
   AND o.object_name = i.index_name LEFT outer join sys.ind$ si 
    on si.obj# = o.object_id 
 WHERE i.owner = '&own'
   AND i.index_name = '&indx'; 
 
 
